{
  "manifest_version": 3,
  "name": "Fix LinkedIn Layout",
  "version": "1.0.0",
  "description": "Full-width, aligned LinkedIn columns with messaging docked as a permanent right sidebar.",
  "icons": { "16": "icons/16.png", "48": "icons/48.png", "128": "icons/128.png" },
  "permissions": ["storage", "activeTab"],
  "action": { "default_popup": "popup.html", "default_title": "Fix LinkedIn Layout" },
  "content_scripts": [
    {
      "matches": ["https://www.linkedin.com/*"],
      "css": ["content.css"],
      "js": ["content.js"],
      "all_frames": true,
      "run_at": "document_end"
    }
  ]
}
