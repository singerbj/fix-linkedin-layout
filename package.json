{
  "name": "fix-linkedin-layout",
  "version": "1.0.0",
  "private": true,
  "description": "Chrome extension that fixes LinkedIn's desktop layout: full-width aligned columns and a docked messaging sidebar.",
  "type": "module",
  "scripts": {
    "build": "node scripts/build.mjs",
    "watch": "node scripts/build.mjs --watch",
    "typecheck": "tsc --noEmit",
    "test": "npm run build && node --test --test-concurrency=1 test/*.test.mjs"
  },
  "devDependencies": {
    "@types/chrome": "^0.1.0",
    "esbuild": "^0.25.0",
    "playwright": "1.56.1",
    "typescript": "^5.9.0"
  }
}
